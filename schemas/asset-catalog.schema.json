{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanxiang-wudao.local/schemas/asset-catalog.schema.json",
  "title": "AssetCatalog",
  "type": "object",
  "required": ["version", "records"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hexagram_id", "state", "version", "history"],
        "additionalProperties": true,
        "properties": {
          "hexagram_id": {"type": "integer", "minimum": 1, "maximum": 64},
          "state": {
            "enum": [
              "DRAFT", "RESEARCHED", "TEXT_VERIFIED", "ART_DRAFT",
              "ART_APPROVED", "LAYOUT_READY", "REVIEW_REQUIRED", "PUBLISHED",
              "BLOCKED", "REJECTED", "REVISION_REQUIRED"
            ]
          },
          "version": {"type": "string", "minLength": 1},
          "release_version": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1}
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "actor", "at"],
              "additionalProperties": true,
              "properties": {
                "from": {"type": "string"},
                "to": {"type": "string"},
                "actor": {"type": "string"},
                "note": {"type": "string"},
                "at": {"type": "string"},
                "revision_scope": {
                  "oneOf": [
                    {"type": "null"},
                    {"type": "string", "enum": ["text", "art", "layout"]}
                  ]
                },
                "approval": {
                  "oneOf": [
                    {"type": "null"},
                    {"type": "object"}
                  ]
                },
                "release_version": {
                  "oneOf": [
                    {"type": "null"},
                    {"type": "string", "minLength": 1}
                  ]
                }
              }
            }
          }
        },
        "if": {
          "properties": {"state": {"const": "PUBLISHED"}},
          "required": ["state"]
        },
        "then": {
          "required": ["approval", "release_version"],
          "properties": {
            "release_version": {
              "type": "string",
              "minLength": 1
            },
            "approval": {
              "type": "object",
              "required": ["approved_by", "approved_at", "gates"],
              "properties": {
                "approved_by": {"type": "string", "minLength": 1, "pattern": "\\S"},
                "approved_at": {"type": "string", "minLength": 1},
                "gates": {
                  "type": "object",
                  "required": ["G1", "G2", "G3"],
                  "properties": {
                    "G1": {"const": "passed"},
                    "G2": {"const": "passed"},
                    "G3": {"const": "passed"}
                  }
                },
                "interpretation_review": {"type": "string"},
                "review_hashes": {
                  "type": "object",
                  "properties": {
                    "g1":             {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "g2":             {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "g3":             {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "interpretation": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                },
                "canonical_text_version": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "release_version": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
