  "entries": [
    {
      "text_id": "H10-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "履：九五阳刚居中得正，处至尊之位而心无疚愧，行事光明磊落，是履道能够贯彻到底、成就尊位典范的关键。全彖传由六三之柔、兑体之悦，讲到九五之刚中正，说明履道既要有谨慎谦悦的心态，也要有中正光明的操守，二者相辅而成。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "履，柔履刚也。说而应乎乾，是以履虎尾，不咥人，亨。刚中正，履帝位而不疚，光明也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "上天下泽，履。君子以辩上下，定民志。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "素履，往无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "履道坦坦，幽人贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "眇能视，跛能履，履虎尾，咥人，凶。武人为于大君。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "履虎尾，愬愬，终吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "夬履，贞厉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "视履考祥，其旋元吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“素履之往”，独行愿也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“幽人贞吉”，中不自乱也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“眇能视”，不足以有明也；“跛能履”，不足以与行也；“咥人”之凶，位不当也；“武人为于大君”，志刚也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“愬愬终吉”，志行也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“夬履贞厉”，位正当也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H10-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "元吉在上，大有庆也。",
      "status": "candidate_from_ching"
    }
  ]
}
