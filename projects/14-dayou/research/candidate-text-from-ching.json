  "entries": [
    {
      "text_id": "H14-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大有：元亨。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大有，柔得尊位大中，而上下应之，曰大有。其德刚健而文明，应乎天而时行，是以元亨。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "火在天上，大有。君子以遏恶扬善，顺天休命。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "无交害，匪咎，艰则无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "大车以载，有攸往，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "公用亨于天子，小人弗克。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "匪其彭，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "厥孚交如，威如，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "自天祐之，吉无不利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“大有”初九，无交害也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“大车以载”，积中不败也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“公用亨于天子”，小人害也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“匪其彭无咎”，明辨晳也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“厥孚交如”，信以发志也；“威如”之吉，易而无备也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H14-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "大有上吉，自天祐也。",
      "status": "candidate_from_ching"
    }
  ]
}
