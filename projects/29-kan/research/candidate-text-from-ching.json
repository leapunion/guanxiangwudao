  "entries": [
    {
      "text_id": "H29-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "坎：有孚，维心亨，行有尚。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "习坎，重险也。水流而不盈，行险而不失其信。维心亨，乃以刚中也。行有尚，往有功也。天险不可升也，地险山川丘陵也。王公设险以守其国。险之时用大矣哉！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "水洊至，习坎。君子以常德行，习教事。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "习坎，入于坎窞，凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "坎有险，求小得。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "来之坎坎，险且枕，入于坎窞，勿用。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "樽酒簋贰，用缶，纳约自牖，终无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "坎不盈，祗既平，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "系用徽纆，寘于丛棘，三岁不得，凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "习坎入坎，失道凶也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "求小得，未出中也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "来之坎坎，终无功也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "樽酒簋贰，刚柔际也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "坎不盈，中未大也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H29-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "上六失道，凶三岁也。",
      "status": "candidate_from_ching"
    }
  ]
}
