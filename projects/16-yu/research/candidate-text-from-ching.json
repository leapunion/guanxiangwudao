  "entries": [
    {
      "text_id": "H16-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "豫：利建侯行师。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "豫，刚应而志行，顺以动，豫。豫顺以动，故天地如之，而况建侯行师乎？天地以顺动，故日月不过，而四时不忒；圣人以顺动，则刑罚清而民服。豫之时义大矣哉！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "雷出地奋，豫。先王以作乐崇德，殷荐之上帝，以配祖考。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "鸣豫，凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "介于石，不终日，贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "盱豫，悔。迟有悔。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "由豫，大有得。勿疑，朋盍簪。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "贞疾，恒不死。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "冥豫，成有渝，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "初六“鸣豫”，志穷凶也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“不终日贞吉”，以中正也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“盱豫”有悔，位不当也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“由豫大有得”，志大行也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "六五“贞疾”，乘刚也；“恒不死”，中未亡也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H16-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“冥豫”在上，何可长也。",
      "status": "candidate_from_ching"
    }
  ]
}
