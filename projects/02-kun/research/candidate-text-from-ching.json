  "entries": [
    {
      "text_id": "H02-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "坤：元，亨，利牝马之贞。君子有攸往，先迷；后得主，利。西南得朋，东北丧朋。安贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "至哉坤元，万物资生，乃顺承天。坤厚载物，德合无疆。含弘光大，品物咸亨。牝马地类，行地无疆，柔顺利贞。君子攸行，先迷失道，后顺得常。西南得朋，乃与类行。东北丧朋，乃终有庆。安贞之吉，应地无疆。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "地势坤。君子以厚德载物。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "履霜，坚冰至。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "直方大，不习，无不利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "含章，可贞，或从王事，无成有终。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "括囊，无咎无誉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "黄裳，元吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "龙战于野，其血玄黄。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“履霜坚冰”，阴始凝也，驯致其道，至坚冰也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "六二之动，直以方也。“不习，无不利”，地道光也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“含章可贞”，以时发也。“或从王事”，知光大也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“括囊无咎”，慎不害也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“黄裳元吉”，文在中也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“龙战于野”，其道穷也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H02-yong-用六",
      "text_type": "yong",
      "line_position": "用六",
      "line_name": "用六",
      "candidate_text": "利永贞。",
      "status": "candidate_from_ching"
    }
  ]
}
