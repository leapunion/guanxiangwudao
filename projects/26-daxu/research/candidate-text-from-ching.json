  "entries": [
    {
      "text_id": "H26-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大畜：利贞。不家食吉，利涉大川。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大畜，刚健笃实辉光，日新其德。刚上而尚贤，能止健，大正也。不家食吉，养贤也。利涉大川，应乎天也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "天在山中，大畜。君子以多识前言往行，以畜其德。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "有厉，利已。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "舆说輹。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "良马逐，利艰贞。曰闲舆卫，利有攸往。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "童牛之牿，元吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "豮豕之牙，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "何天之衢，亨。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "有厉利已，不犯灾也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "舆说輹，中无尤也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "利有攸往，上合志也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "六四元吉，有喜也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "六五之吉，有庆也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H26-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "何天之衢，道大行也。",
      "status": "candidate_from_ching"
    }
  ]
}
