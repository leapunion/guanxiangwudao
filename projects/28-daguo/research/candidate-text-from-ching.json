  "entries": [
    {
      "text_id": "H28-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大过：栋桡。利有攸往，亨。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大过，大者过也。栋桡，本末弱也。刚过而中，巽而说行，利有攸往，乃亨。大过之时大矣哉！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "泽灭木，大过。君子以独立不惧，遁世无闷。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "藉用白茅，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "枯杨生稊，老夫得其女妻，无不利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "栋桡，凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "栋隆，吉。有它吝。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "枯杨生华，老妇得其士夫，无咎无誉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "过涉灭顶，凶，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "藉用白茅，柔在下也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "老夫女妻，过以相与也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "栋桡之凶，不可以有辅也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "栋隆之吉，不桡乎下也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "枯杨生华，何可久也？老妇士夫，亦可丑也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H28-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "过涉之凶，不可咎也。",
      "status": "candidate_from_ching"
    }
  ]
}
