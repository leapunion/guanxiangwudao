  "entries": [
    {
      "text_id": "H48-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "井：改邑不改井，无丧无得，往来井井。汔至，亦未繘井，羸其瓶，凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "巽乎水而上水，井。井养而不穷也。改邑不改井，乃以刚中也。汔至亦未繘井，未有功也。羸其瓶，是以凶也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "木上有水，井。君子以劳民劝相。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "井泥不食，旧井无禽。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "井谷射鲋，瓮敝漏。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "井渫不食，为我心恻。可用汲，王明，并受其福。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "井甃，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "井冽，寒泉食。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "井收勿幕，有孚元吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“井泥不食”，下也；“旧井无禽”，时舍也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“井谷射鲋”，无与也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“井渫不食”，行恻也；求王明，受福也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“井甃无咎”，修井也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "寒泉之食，中正也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H48-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "元吉在上，大成也。",
      "status": "candidate_from_ching"
    }
  ]
}
