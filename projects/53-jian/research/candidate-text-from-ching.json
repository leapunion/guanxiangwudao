  "entries": [
    {
      "text_id": "H53-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "渐：女归吉，利贞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "渐之进也，女归吉也。进得位，往有功也。进以正，可以正邦也。其位，刚得中也。止而巽，动不穷也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "山上有木，渐。君子以居贤德善俗。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "鸿渐于干，小子厉，有言，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "鸿渐于磐，饮食衎衎，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "鸿渐于陆，夫征不复，妇孕不育，凶。利御寇。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "鸿渐于木，或得其桷，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "鸿渐于陵，妇三岁不孕，终莫之胜，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "鸿渐于陆，其羽可用为仪，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“小子之厉”，义无咎也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“饮食衎衎”，不素饱也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“夫征不复”，离群丑也；“妇孕不育”，失其道也；“利用御寇”，顺相保也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“或得其桷”，顺以巽也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“终莫之胜”吉，得所愿也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H53-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“其羽可用为仪”吉，不可乱也。",
      "status": "candidate_from_ching"
    }
  ]
}
