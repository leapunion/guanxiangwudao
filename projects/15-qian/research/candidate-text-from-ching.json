  "entries": [
    {
      "text_id": "H15-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "谦：亨，君子有终。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "谦，亨，天道下济而光明，地道卑而上行。天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。谦尊而光，卑而不可逾，君子之终也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "地中有山，谦。君子以裒多益寡，称物平施。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "谦谦君子，用涉大川，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "鸣谦，贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "劳谦，君子有终，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "无不利，撝谦。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "不富以其邻，利用侵伐，无不利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "鸣谦，利用行师，征邑国。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“谦谦君子”，卑以自牧也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“鸣谦贞吉”，中心得也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“劳谦君子”，万民服也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“无不利撝谦”，不违则也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“利用侵伐”，征不服也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H15-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“鸣谦”，志未得也；可用行师，征邑国也。",
      "status": "candidate_from_ching"
    }
  ]
}
