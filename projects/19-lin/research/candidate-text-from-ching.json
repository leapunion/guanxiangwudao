  "entries": [
    {
      "text_id": "H19-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "临：元亨利贞。至于八月有凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "临，刚浸而长，说而顺，刚中而应，大亨以正，天之道也。至于八月有凶，消不久也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "泽上有地，临。君子以教思无穷，容保民无疆。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "咸临，贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "咸临，吉，无不利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "甘临，无攸利。既忧之，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "至临，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "知临，大君之宜，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "敦临，吉，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“咸临贞吉”，志行正也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“咸临吉无不利”，未顺命也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“甘临”，位不当也。“既忧之”，咎不长也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“至临无咎”，位当也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“大君之宜”，行中之谓也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H19-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“敦临之吉”，志在内也。",
      "status": "candidate_from_ching"
    }
  ]
}
