  "entries": [
    {
      "text_id": "H39-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "蹇：利西南，不利东北。利见大人，贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "蹇，难也，险在前也。见险而能止，知矣哉！蹇利西南，往得中也；不利东北，其道穷也。利见大人，往有功也；当位贞吉，以正邦也。蹇之时用大矣哉！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "山上有水，蹇。君子以反身修德。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "往蹇，来誉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "王臣蹇蹇，匪躬之故。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "往蹇，来反。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "往蹇，来连。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "大蹇，朋来。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "往蹇，来硕，吉，利见大人。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“往蹇来誉”，宜待也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“王臣蹇蹇”，终无尤也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“往蹇来反”，内喜之也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“往蹇来连”，当位实也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“大蹇朋来”，以中节也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H39-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“往蹇来硕”，志在内也；利见大人，以从贵也。",
      "status": "candidate_from_ching"
    }
  ]
}
