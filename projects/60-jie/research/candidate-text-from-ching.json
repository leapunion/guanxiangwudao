  "entries": [
    {
      "text_id": "H60-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "节：亨。苦节不可贞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "节，亨，刚柔分而刚得中。苦节不可贞，其道穷也。说以行险，当位以节，中正以通。天地节而四时成。节以制度，不伤财，不害民。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "泽上有水，节。君子以制数度，议德行。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "不出户庭，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "不出门庭，凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "不节若，则嗟若，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "安节，亨。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "甘节，吉，往有尚。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "苦节，贞凶，悔亡。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“不出户庭”，知通塞也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“不出门庭”凶，失时极也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "不节之嗟，又谁咎也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "安节之亨，承上道也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "甘节之吉，居位中也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H60-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "苦节贞凶，其道穷也。",
      "status": "candidate_from_ching"
    }
  ]
}
