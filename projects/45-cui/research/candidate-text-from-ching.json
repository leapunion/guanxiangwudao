  "entries": [
    {
      "text_id": "H45-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "萃：亨。王假有庙，利见大人，亨，利贞。用大牲吉，利有攸往。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "萃，聚也。顺以说，刚中而应，故聚也。王假有庙，致孝享也。利见大人亨，聚以正也。用大牲吉，利有攸往，顺天命也。观其所聚，而天地万物之情可见矣。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "泽上于地，萃。君子以除戎器，戒不虞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "有孚不终，乃乱乃萃。若号，一握为笑，勿恤，往无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "引吉，无咎，孚乃利用禴。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "萃如嗟如，无攸利。往无咎，小吝。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "大吉，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "萃有位，无咎。匪孚，元永贞，悔亡。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "赍咨涕洟，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“乃乱乃萃”，其志乱也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“引吉无咎”，中未变也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“往无咎”，上巽也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“大吉无咎”，位不当也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“萃有位”，志未光也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H45-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "赍咨涕洟，未安上也。",
      "status": "candidate_from_ching"
    }
  ]
}
