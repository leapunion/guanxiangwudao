  "entries": [
    {
      "text_id": "H33-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "遁：亨，小利贞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "遁亨，遁而亨也。刚当位而应，与时行也。小利贞，浸而长也。遁之时义大矣哉！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "天下有山，遁。君子以远小人，不恶而严。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "遁尾，厉，勿用有攸往。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "执之用黄牛之革，莫之胜说。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "系遁，有疾厉，畜臣妾吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "好遁，君子吉，小人否。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "嘉遁，贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "肥遁，无不利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“遁尾之厉”，不往何灾也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "执用黄牛，固志也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“系遁之厉”，有疾惫也；“畜臣妾吉”，不可大事也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "君子好遁，小人否也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“嘉遁贞吉”，以正志也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H33-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“肥遁无不利”，无所疑也。",
      "status": "candidate_from_ching"
    }
  ]
}
