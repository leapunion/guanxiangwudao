  "entries": [
    {
      "text_id": "H63-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "既济：亨小，利贞。初吉终乱。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "既济，亨，小者亨也。利贞，刚柔正而位当也。初吉，柔得中也。终止则乱，其道穷也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "水在火上，既济。君子以思患而豫防之。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "曳其轮，濡其尾，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "妇丧其茀，勿逐，七日得。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "高宗伐鬼方，三年克之，小人勿用。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "繻有衣袽，终日戒。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "东邻杀牛，不如西邻之禴祭，实受其福。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "濡其首，厉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“曳其轮”，义无咎也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“七日得”，以中道也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“三年克之”，惫也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“终日戒”，有所疑也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“东邻杀牛”，不如西邻之时也；“实受其福”，吉大来也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H63-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“濡其首”厉，何可久也。",
      "status": "candidate_from_ching"
    }
  ]
}
