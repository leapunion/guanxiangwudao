  "entries": [
    {
      "text_id": "H41-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "损：有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "损，损下益上，其道上行。损而有孚，元吉。无咎，可贞，利有攸往，曷之用？二簋可用享，二簋应有时，损刚益柔有时。损益盈虚，与时偕行。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "山下有泽，损。君子以惩忿窒欲。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "已事遄往，无咎，酌损之。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "利贞，征凶，弗损益之。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "三人行，则损一人；一人行，则得其友。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "损其疾，使遄有喜，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "或益之十朋之龟，弗克违，元吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "弗损益之，无咎，贞吉，利有攸往，得臣无家。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“已事遄往”，尚合志也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "九二利贞，中以为志也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“一人行”，三则疑也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“损其疾”，亦可喜也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "六五元吉，自上祐也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H41-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“弗损益之”，大得志也。",
      "status": "candidate_from_ching"
    }
  ]
}
