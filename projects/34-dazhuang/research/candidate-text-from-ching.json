  "entries": [
    {
      "text_id": "H34-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大壮：利贞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "大壮，大者壮也。刚以动，故壮。大壮利贞，大者正也。正大而天地之情可见矣。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "雷在天上，大壮。君子以非礼弗履。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "壮于趾，征凶，有孚。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "贞吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "小人用壮，君子用罔，贞厉。羝羊触藩，羸其角。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "贞吉，悔亡。藩决不羸，壮于大舆之輹。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "丧羊于易，无悔。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "羝羊触藩，不能退，不能遂，无攸利，艰则吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“壮于趾”，其孚穷也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "九二贞吉，以中也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "小人用壮，君子罔也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“藩决不羸”，尚往也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“丧羊于易”，位不当也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H34-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "不能退，不能遂，不详也；艰则吉，咎不长也。",
      "status": "candidate_from_ching"
    }
  ]
}
