  "entries": [
    {
      "text_id": "H51-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "震：亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "震，亨。震来虩虩，恐致福也。笑言哑哑，后有则也。震惊百里，惊远而惧迩也。不丧匕鬯，出可以守宗庙社稷，以为祭主也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "洊雷，震。君子以恐惧修省。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "震来虩虩，后笑言哑哑，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "震来厉，亿丧贝，跻于九陵，勿逐，七日得。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "震苏苏，震行无眚。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "震遂泥。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "震往来厉，亿无丧，有事。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "震索索，视矍矍，征凶。震不于其躬，于其邻，无咎。婚媾有言。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“震来虩虩”，恐致福也；“笑言哑哑”，后有则也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“震来厉”，乘刚也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“震苏苏”，位不当也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“震遂泥”，未光也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“震往来厉”，危行也；其事在中，大无丧也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H51-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“震索索”，中未得也；虽凶无咎，畏邻戒也。",
      "status": "candidate_from_ching"
    }
  ]
}
