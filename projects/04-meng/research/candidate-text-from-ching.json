  "entries": [
    {
      "text_id": "H04-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "蒙，山下有险，险而止，蒙。“蒙亨”，以亨行时中也。“匪我求童蒙，童蒙求我”，志应也。“初筮告”，以刚中也。“再三渎，渎则不告”，渎蒙也。蒙以养正，圣功也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "山下出泉，蒙。君子以果行育德。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "发蒙，利用刑人，用说桎梏，以往吝。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "包蒙，吉。纳妇，吉。子克家。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "勿用取女，见金夫，不有躬，无攸利。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "困蒙，吝。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "童蒙，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "击蒙，不利为寇，利御寇。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“利用刑人”，以正法也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“子克家”，刚柔接也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“勿用取女”，行不顺也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“困蒙之吝”，独远实也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“童蒙”之“吉”，顺以巽也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H04-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“利用御寇”，上下顺也。",
      "status": "candidate_from_ching"
    }
  ]
}
