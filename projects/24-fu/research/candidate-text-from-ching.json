  "entries": [
    {
      "text_id": "H24-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "复：亨。出入无疾，朋来无咎。反复其道，七日来复，利有攸往。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "复，亨。刚反，动而以顺行，是以出入无疾，朋来无咎。反复其道，七日来复，天行也。利有攸往，刚长也。复，其见天地之心乎！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "雷在地中，复。先王以至日闭关，商旅不行，后不省方。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初九",
      "candidate_text": "不远复，无祗悔，元吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "六二",
      "candidate_text": "休复，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "六三",
      "candidate_text": "频复，厉，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "中行独复。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "六五",
      "candidate_text": "敦复，无悔。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上六",
      "candidate_text": "迷复，凶，有灾眚。用行师，终有大败，以其国君凶，至于十年不克征。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“不远之复”，以修身也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“休复之吉”，以下仁也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“频复之厉”，义无咎也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“中行独复”，以从道也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "“敦复无悔”，中以自考也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H24-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“迷复之凶”，反君道也。",
      "status": "candidate_from_ching"
    }
  ]
}
