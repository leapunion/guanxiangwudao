  "entries": [
    {
      "text_id": "H57-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "巽：小亨，利有攸往，利见大人。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "重巽以申命。刚巽乎中正而志行，柔皆顺乎刚，是以小亨。利有攸往，利见大人。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "随风，巽。君子以申命行事。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "进退，利武人之贞。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "巽在床下，用史巫纷若，吉，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "频巽，吝。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "六四",
      "candidate_text": "悔亡，田获三品。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "贞吉，悔亡，无不利。无初有终。先庚三日，后庚三日，吉。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "巽在床下，丧其资斧，贞凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“进退”，志疑也；“利武人之贞”，志治也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“纷若”之吉，得中也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“频巽”之吝，志穷也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "“田获三品”，有功也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "九五之吉，位正中也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H57-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“巽在床下”，上穷也；“丧其资斧”，正乎凶也。",
      "status": "candidate_from_ching"
    }
  ]
}
