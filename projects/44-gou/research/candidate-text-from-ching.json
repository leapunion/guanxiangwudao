  "entries": [
    {
      "text_id": "H44-gua_ci",
      "text_type": "gua_ci",
      "line_position": null,
      "line_name": null,
      "candidate_text": "姤：女壮，勿用取女。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-tuan",
      "text_type": "tuan",
      "line_position": null,
      "line_name": null,
      "candidate_text": "姤，遇也，柔遇刚也。勿用取女，不可与长也。天地相遇，品物咸章也。刚遇中正，天下大行也。姤之时义大矣哉！",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-da_xiang",
      "text_type": "da_xiang",
      "line_position": null,
      "line_name": null,
      "candidate_text": "天下有风，姤。后以施命诰四方。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-yao_ci-L1",
      "text_type": "yao_ci",
      "line_position": 1,
      "line_name": "初六",
      "candidate_text": "系于金柅，贞吉。有攸往，见凶，羸豕孚蹢躅。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-yao_ci-L2",
      "text_type": "yao_ci",
      "line_position": 2,
      "line_name": "九二",
      "candidate_text": "包有鱼，无咎，不利宾。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-yao_ci-L3",
      "text_type": "yao_ci",
      "line_position": 3,
      "line_name": "九三",
      "candidate_text": "臀无肤，其行次且，厉，无大咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-yao_ci-L4",
      "text_type": "yao_ci",
      "line_position": 4,
      "line_name": "九四",
      "candidate_text": "包无鱼，起凶。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-yao_ci-L5",
      "text_type": "yao_ci",
      "line_position": 5,
      "line_name": "九五",
      "candidate_text": "以杞包瓜，含章，有陨自天。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-yao_ci-L6",
      "text_type": "yao_ci",
      "line_position": 6,
      "line_name": "上九",
      "candidate_text": "姤其角，吝，无咎。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-xiao_xiang-L1",
      "text_type": "xiao_xiang",
      "line_position": 1,
      "line_name": null,
      "candidate_text": "“系于金柅”，柔道牵也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-xiao_xiang-L2",
      "text_type": "xiao_xiang",
      "line_position": 2,
      "line_name": null,
      "candidate_text": "“包有鱼”，义不及宾也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-xiao_xiang-L3",
      "text_type": "xiao_xiang",
      "line_position": 3,
      "line_name": null,
      "candidate_text": "“其行次且”，行未牵也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-xiao_xiang-L4",
      "text_type": "xiao_xiang",
      "line_position": 4,
      "line_name": null,
      "candidate_text": "无鱼之凶，远民也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-xiao_xiang-L5",
      "text_type": "xiao_xiang",
      "line_position": 5,
      "line_name": null,
      "candidate_text": "九五含章，中正也；有陨自天，志不舍命也。",
      "status": "candidate_from_ching"
    },
    {
      "text_id": "H44-xiao_xiang-L6",
      "text_type": "xiao_xiang",
      "line_position": 6,
      "line_name": null,
      "candidate_text": "“姤其角”，上穷吝也。",
      "status": "candidate_from_ching"
    }
  ]
}
